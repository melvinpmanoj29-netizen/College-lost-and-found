# ====================================================
# Environment Variables Template — College Lost & Found
# Copy this file to .env and fill in real values.
# NEVER commit .env — only commit .env.example
# ====================================================

# Database
DB_USERNAME=root
DB_PASSWORD=your_db_password_here

# JWT (must be at least 32 characters, use a strong random value)
JWT_SECRET=your_very_long_jwt_secret_min_32_chars_here
JWT_EXPIRATION_MS=86400000

# Admin bootstrap account (first run only)
ADMIN_EMAIL=admin@college.edu
ADMIN_PASSWORD=your_strong_admin_password_here

# Email SMTP (use an app password, not your real password)
MAIL_HOST=smtp.gmail.com
MAIL_PORT=587
MAIL_USERNAME=your_email@gmail.com
MAIL_PASSWORD=your_gmail_app_password_here

# Cloudinary (server-side only — NEVER put these in frontend code)
CLOUDINARY_CLOUD_NAME=your_cloud_name
CLOUDINARY_API_KEY=your_api_key
CLOUDINARY_API_SECRET=your_api_secret

# Frontend URL (for password reset email links)
APP_FRONTEND_URL=http://localhost:5173
